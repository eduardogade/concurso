digraph mapa {
  graph [fontname="Arial" fontsize=11 fontcolor="#111111" bgcolor="white" rankdir=TB newrank=true nodesep=0.55 ranksep=0.24 labelloc="t" labeljust="c" margin=0.1 pad=0.2];
  node [shape=box style="filled" fillcolor="white" color="#2b2b2b" penwidth=1.2 fontname="Arial" fontsize=12 fontcolor="#111111" margin="0.14,0.06" height=0.36];
  edge [color="#333333" penwidth=1.3 arrowsize=0.8];
  label=<<FONT POINT-SIZE="16"><B>Ponto 3</B></FONT><BR/><FONT POINT-SIZE="12">Processamento de Dados em Larga Escala:<BR/>Processamento de Fluxos e Arquiteturas de Dados</FONT><BR/> >;
  subgraph cluster_3_1 {
    label=<<B>3.1</B>&#160;&#160;Introdução e Delimitação do Problema>; labeljust="l"; style="filled"; fillcolor="#f2f2f2"; color="#d4d4d4"; margin=10;
    n3_1_0_0 [label=<<B>fluxo</B> ↔ <B>batch</B>> group="eixo"];
    n3_1_1_0 [label=<atraso · desordem · estado · falhas → <B>correção</B>> group="eixo"];
    n3_1_0_0 -> n3_1_1_0;
    n3_1_2_0 [label=<<B>4 eixos</B>: tempo · estado · garantias · armazenamento> group="eixo"];
    n3_1_1_0 -> n3_1_2_0;
  }
  subgraph cluster_3_2 {
    label=<<B>3.2</B>&#160;&#160;Fundamentos e Relevância>; labeljust="l"; style="filled"; fillcolor="#f2f2f2"; color="#d4d4d4"; margin=10;
    n3_2_0_0 [label=<<B>bounded</B> ↔ <B>unbounded</B>> group="eixo"];
    n3_2_1_0 [label=<<B>latência</B> · <B>throughput</B>> group="eixo"];
    n3_2_0_0 -> n3_2_1_0;
    n3_2_2_0 [label=<particionar: + throughput, − <B>ordem global</B>> group="eixo"];
    n3_2_1_0 -> n3_2_2_0;
  }
  subgraph cluster_3_3 {
    label=<<B>3.3</B>&#160;&#160;Núcleo Técnico>; labeljust="l"; style="dashed"; color="#bdbdbd"; margin=10;
    subgraph cluster_3_3_1 {
      label=<<B>3.3.1</B>&#160;&#160;Tempo, Janelas e Watermarks>; labeljust="l"; style="filled"; fillcolor="#f2f2f2"; color="#d4d4d4"; margin=10;
      n3_3_1_0_0 [label=<<B>event time</B> ≠ processing time> group="eixo"];
      n3_3_1_1_0 [label=<<B>janelas</B> (3 tipos) · modelo <B>Dataflow</B>> group="eixo"];
      n3_3_1_0_0 -> n3_3_1_1_0;
      n3_3_1_2_0 [label=<<B>watermark</B> = estimativa →<BR/>latência × completude × estado> group="eixo"];
      n3_3_1_1_0 -> n3_3_1_2_0;
    }
    subgraph cluster_3_3_2 {
      label=<<B>3.3.2</B>&#160;&#160;Estado, Recuperação e Semântica de Processamento>; labeljust="l"; style="filled"; fillcolor="#f2f2f2"; color="#d4d4d4"; margin=10;
      n3_3_2_0_0 [label=<<B>stateful</B>: (s<FONT POINT-SIZE="9"><SUB>t+1</SUB></FONT>, y<FONT POINT-SIZE="9"><SUB>t</SUB></FONT>) = f(s<FONT POINT-SIZE="9"><SUB>t</SUB></FONT>, x<FONT POINT-SIZE="9"><SUB>t</SUB></FONT>)> group="eixo"];
      n3_3_2_1_0 [label=<falha → <B>checkpoint</B> + replay (Flink)> group="eixo"];
      n3_3_2_0_0 -> n3_3_2_1_0;
      n3_3_2_2_0 [label=<<B>exactly-once</B> = efeito no estado ≠ entrega> group="eixo"];
      n3_3_2_1_0 -> n3_3_2_2_0;
    }
    subgraph cluster_3_3_3 {
      label=<<B>3.3.3</B>&#160;&#160;Logs Distribuídos e Arquiteturas Orientadas a Eventos>; labeljust="l"; style="filled"; fillcolor="#f2f2f2"; color="#d4d4d4"; margin=10;
      n3_3_3_0_0 [label=<<B>Kafka</B>: log desacopla produtor ↔ consumidor> group="eixo"];
      n3_3_3_1_0 [label=<<B>offset</B> → replay · ordem por partição> group="eixo"];
      n3_3_3_0_0 -> n3_3_3_1_0;
      n3_3_3_2_0 [label=<<B>log</B> ≠ <B>motor</B> de processamento> group="eixo"];
      n3_3_3_1_0 -> n3_3_3_2_0;
    }
    subgraph cluster_3_3_4 {
      label=<<B>3.3.4</B>&#160;&#160;Integração Batch/Streaming e Arquiteturas de Dados>; labeljust="l"; style="filled"; fillcolor="#f2f2f2"; color="#d4d4d4"; margin=10;
      n3_3_4_0_0 [label=<<B>Lambda</B>: 2 camadas → duplicação>];
      n3_3_4_0_1 [label=<<B>Kappa</B>: recomputa por replay>];
      n3_3_4_0_m [shape=point width=0 height=0 style=invis group="eixo"];
      { rank=same; n3_3_4_0_0; n3_3_4_0_m; n3_3_4_0_1; }
      n3_3_4_0_0 -> n3_3_4_0_m [dir=back headclip=false];
      n3_3_4_0_m -> n3_3_4_0_1 [ tailclip=false];
      n3_3_4_1_0 [label=<data lake → <B>lakehouse</B>> group="eixo"];
      n3_3_4_0_0 -> n3_3_4_1_0;
      n3_3_4_0_1 -> n3_3_4_1_0;
      n3_3_4_0_m -> n3_3_4_1_0 [style=invis];
    }
  }
  subgraph cluster_3_4 {
    label=<<B>3.4</B>&#160;&#160;Limitações, Trade-offs e Desafios Atuais>; labeljust="l"; style="filled"; fillcolor="#f2f2f2"; color="#d4d4d4"; margin=10;
    n3_4_0_0 [label=<garantias fortes custam → <B>menor complexidade</B>> group="eixo"];
    n3_4_1_0 [label=<λ<FONT POINT-SIZE="9"><SUB>produção</SUB></FONT> &gt; λ<FONT POINT-SIZE="9"><SUB>consumo</SUB></FONT> → <B>backlog</B> → backpressure> group="eixo"];
    n3_4_0_0 -> n3_4_1_0;
    n3_4_2_0 [label=<desacoplar ≠ dispensar <B>contratos de dados</B>> group="eixo"];
    n3_4_1_0 -> n3_4_2_0;
  }
  subgraph cluster_3_5 {
    label=<<B>3.5</B>&#160;&#160;Conclusão>; labeljust="l"; style="filled"; fillcolor="#f2f2f2"; color="#d4d4d4"; margin=10;
    n3_5_0_0 [label=<dados em <B>movimento</B> + dados <B>persistidos</B>> group="eixo"];
    n3_5_1_0 [label=<<B>garantias</B> exigidas decidem, não a novidade> group="eixo"];
    n3_5_0_0 -> n3_5_1_0;
  }
  n3_1_2_0 -> n3_2_0_0 [style=invis];
  n3_2_2_0 -> n3_3_1_0_0 [style=invis];
  n3_3_1_2_0 -> n3_3_2_0_0 [style=invis];
  n3_3_2_2_0 -> n3_3_3_0_0 [style=invis];
  n3_3_3_2_0 -> n3_3_4_0_m [style=invis];
  n3_3_4_1_0 -> n3_4_0_0 [style=invis];
  n3_4_2_0 -> n3_5_0_0 [style=invis];
}
