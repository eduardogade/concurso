digraph mapa {
  graph [fontname="Arial" fontsize=11 fontcolor="#111111" bgcolor="white" rankdir=TB newrank=true nodesep=0.55 ranksep=0.24 labelloc="t" labeljust="c" margin=0.1 pad=0.2];
  node [shape=box style="filled" fillcolor="white" color="#2b2b2b" penwidth=1.2 fontname="Arial" fontsize=12 fontcolor="#111111" margin="0.14,0.06" height=0.36];
  edge [color="#333333" penwidth=1.3 arrowsize=0.8];
  label=<<FONT POINT-SIZE="16"><B>Ponto 1</B></FONT><BR/><FONT POINT-SIZE="12">Processamento de Dados em Larga Escala:<BR/>Armazenamento e Gerenciamento Distribuído de Dados</FONT><BR/> >;
  subgraph cluster_1_1 {
    label=<<B>1.1</B>&#160;&#160;Introdução e Delimitação do Problema>; labeljust="l"; style="filled"; fillcolor="#f2f2f2"; color="#d4d4d4"; margin=10;
    n1_1_0_0 [label=<<B>Vertical</B> → 3 limites> group="eixo"];
    n1_1_1_0 [label=<<B>Horizontal</B> → solução> group="eixo"];
    n1_1_0_0 -> n1_1_1_0;
    n1_1_2_0 [label=<rede + <B>falhas parciais</B> → 4 propriedades em risco> group="eixo"];
    n1_1_1_0 -> n1_1_2_0;
  }
  subgraph cluster_1_2 {
    label=<<B>1.2</B>&#160;&#160;Fundamentos e Relevância>; labeljust="l"; style="filled"; fillcolor="#f2f2f2"; color="#d4d4d4"; margin=10;
    n1_2_0_0 [label=<<B>visão lógica única</B>, sem ganho automático> group="eixo"];
    n1_2_1_0 [label=<<B>particionamento</B> + <B>replicação</B>> group="eixo"];
    n1_2_0_0 -> n1_2_1_0;
    n1_2_2_0 [label=<falhas = condição normal → <B>GFS</B>> group="eixo"];
    n1_2_1_0 -> n1_2_2_0;
  }
  subgraph cluster_1_3 {
    label=<<B>1.3</B>&#160;&#160;Núcleo Técnico>; labeljust="l"; style="dashed"; color="#bdbdbd"; margin=10;
    subgraph cluster_1_3_1 {
      label=<<B>1.3.1</B>&#160;&#160;Particionamento e Distribuição>; labeljust="l"; style="filled"; fillcolor="#f2f2f2"; color="#d4d4d4"; margin=10;
      n1_3_1_0_0 [label=<<B>Range</B> (localidade) ↔ <B>Hash</B> (equilíbrio)> group="eixo"];
      n1_3_1_1_0 [label=<dados equilibrados ≠ <B>carga</B> equilibrada> group="eixo"];
      n1_3_1_0_0 -> n1_3_1_1_0;
      n1_3_1_2_0 [label=<rebalanceamento → <B>consistent hashing</B> (anel)> group="eixo"];
      n1_3_1_1_0 -> n1_3_1_2_0;
    }
    subgraph cluster_1_3_2 {
      label=<<B>1.3.2</B>&#160;&#160;Replicação e Tolerância a Falhas>; labeljust="l"; style="filled"; fillcolor="#f2f2f2"; color="#d4d4d4"; margin=10;
      n1_3_2_0_0 [label=<<B>síncrona</B> ↔ <B>assíncrona</B>: garantia × latência> group="eixo"];
      n1_3_2_1_0 [label=<<B>failover</B> sem consenso → <B>split-brain</B>> group="eixo"];
      n1_3_2_0_0 -> n1_3_2_1_0;
      n1_3_2_2_0 [label=<<B>domínios de falha</B> + detecção → disponibilidade> group="eixo"];
      n1_3_2_1_0 -> n1_3_2_2_0;
    }
    subgraph cluster_1_3_3 {
      label=<<B>1.3.3</B>&#160;&#160;Consistência, Disponibilidade e Quóruns>; labeljust="l"; style="filled"; fillcolor="#f2f2f2"; color="#d4d4d4"; margin=10;
      n1_3_3_0_0 [label=<<B>linearizável</B> ↔ <B>eventual</B>> group="eixo"];
      n1_3_3_1_0 [label=<partição → <B>CAP</B> · sem partição → <B>PACELC</B>> group="eixo"];
      n1_3_3_0_0 -> n1_3_3_1_0;
      n1_3_3_2_0 [label=<<B>R + W &gt; N</B> → leitura e escrita se sobrepõem> group="eixo"];
      n1_3_3_1_0 -> n1_3_3_2_0;
      n1_3_3_3_0 [label=<várias partições → <B>2PC</B> → bloqueio> group="eixo"];
      n1_3_3_2_0 -> n1_3_3_3_0;
    }
    subgraph cluster_1_3_4 {
      label=<<B>1.3.4</B>&#160;&#160;Modelos e Arquiteturas>; labeljust="l"; style="filled"; fillcolor="#f2f2f2"; color="#d4d4d4"; margin=10;
      n1_3_4_0_0 [label=<mesmos mecanismos → GFS · <B>Bigtable</B> · <B>Dynamo</B> · objetos> group="eixo"];
      n1_3_4_1_0 [label=<<B>shared-nothing</B> · separar computação/armazenamento> group="eixo"];
      n1_3_4_0_0 -> n1_3_4_1_0;
    }
  }
  subgraph cluster_1_4 {
    label=<<B>1.4</B>&#160;&#160;Limitações, Trade-offs e Desafios Atuais>; labeljust="l"; style="filled"; fillcolor="#f2f2f2"; color="#d4d4d4"; margin=10;
    n1_4_0_0 [label=<sem arquitetura <B>universal</B> → 4 compromissos> group="eixo"];
    n1_4_1_0 [label=<<B>códigos de apagamento</B> → custo de reconstrução> group="eixo"];
    n1_4_0_0 -> n1_4_1_0;
    n1_4_2_0 [label=<<B>workload</B> decide: banco ↔ catálogo> group="eixo"];
    n1_4_1_0 -> n1_4_2_0;
  }
  subgraph cluster_1_5 {
    label=<<B>1.5</B>&#160;&#160;Conclusão>; labeljust="l"; style="filled"; fillcolor="#f2f2f2"; color="#d4d4d4"; margin=10;
    n1_5_0_0 [label=<particionar + replicar → custo de <B>coordenar</B>> group="eixo"];
    n1_5_1_0 [label=<<B>consistência</B> sob medida> group="eixo"];
    n1_5_0_0 -> n1_5_1_0;
  }
  n1_1_2_0 -> n1_2_0_0 [style=invis];
  n1_2_2_0 -> n1_3_1_0_0 [style=invis];
  n1_3_1_2_0 -> n1_3_2_0_0 [style=invis];
  n1_3_2_2_0 -> n1_3_3_0_0 [style=invis];
  n1_3_3_3_0 -> n1_3_4_0_0 [style=invis];
  n1_3_4_1_0 -> n1_4_0_0 [style=invis];
  n1_4_2_0 -> n1_5_0_0 [style=invis];
}
