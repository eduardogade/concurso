digraph mapa {
  graph [fontname="Arial" fontsize=11 fontcolor="#111111" bgcolor="white" rankdir=TB newrank=true nodesep=0.55 ranksep=0.24 labelloc="t" labeljust="c" margin=0.1 pad=0.2];
  node [shape=box style="filled" fillcolor="white" color="#2b2b2b" penwidth=1.2 fontname="Arial" fontsize=12 fontcolor="#111111" margin="0.14,0.06" height=0.36];
  edge [color="#333333" penwidth=1.3 arrowsize=0.8];
  label=<<FONT POINT-SIZE="16"><B>Ponto 8</B></FONT><BR/><FONT POINT-SIZE="12">MLOps: Automação, Implantação e<BR/>Infraestrutura de Aprendizado de Máquina</FONT><BR/> >;
  subgraph cluster_8_1 {
    label=<<B>8.1</B>&#160;&#160;Introdução e Delimitação do Problema>; labeljust="l"; style="filled"; fillcolor="#f2f2f2"; color="#d4d4d4"; margin=10;
    n8_1_0_0 [label=<modelo validado ≠ <B>sistema confiável</B>> group="eixo"];
    n8_1_1_0 [label=<código = pequena parte (<B>Sculley</B>)> group="eixo"];
    n8_1_0_0 -> n8_1_1_0;
    n8_1_2_0 [label=<escopo: <B>entrega</B> + operação> group="eixo"];
    n8_1_1_0 -> n8_1_2_0;
  }
  subgraph cluster_8_2 {
    label=<<B>8.2</B>&#160;&#160;Fundamentos e Relevância>; labeljust="l"; style="filled"; fillcolor="#f2f2f2"; color="#d4d4d4"; margin=10;
    n8_2_0_0 [label=<manual → <B>pipeline</B> como DAG (Airflow, Kubeflow)> group="eixo"];
    n8_2_1_0 [label=<CI · CD · <B>CT</B> ≠ retreinar sempre> group="eixo"];
    n8_2_0_0 -> n8_2_1_0;
    n8_2_2_0 [label=<<B>quality gates</B> → regra de promoção> group="eixo"];
    n8_2_1_0 -> n8_2_2_0;
  }
  subgraph cluster_8_3 {
    label=<<B>8.3</B>&#160;&#160;Núcleo Técnico>; labeljust="l"; style="dashed"; color="#bdbdbd"; margin=10;
    subgraph cluster_8_3_1 {
      label=<<B>8.3.1</B>&#160;&#160;Empacotamento e Implantação>; labeljust="l"; style="filled"; fillcolor="#f2f2f2"; color="#d4d4d4"; margin=10;
      n8_3_1_0_0 [label=<implantar ≠ copiar <B>pesos</B>> group="eixo"];
      n8_3_1_1_0 [label=<pré/pós + <B>contrato</B> E/S → container (Docker)> group="eixo"];
      n8_3_1_0_0 -> n8_3_1_1_0;
      n8_3_1_2_0 [label=<4 estratégias de liberação + <B>rollback</B>> group="eixo"];
      n8_3_1_1_0 -> n8_3_1_2_0;
    }
    subgraph cluster_8_3_2 {
      label=<<B>8.3.2</B>&#160;&#160;Serving e Padrões de Inferência>; labeljust="l"; style="filled"; fillcolor="#f2f2f2"; color="#d4d4d4"; margin=10;
      n8_3_2_0_0 [label=<<B>batch</B>: escore noturno>];
      n8_3_2_0_1 [label=<<B>online</B>: latência · throughput>];
      n8_3_2_0_m [shape=point width=0 height=0 style=invis group="eixo"];
      { rank=same; n8_3_2_0_0; n8_3_2_0_m; n8_3_2_0_1; }
      n8_3_2_0_0 -> n8_3_2_0_m [dir=back headclip=false];
      n8_3_2_0_m -> n8_3_2_0_1 [ tailclip=false];
      n8_3_2_1_0 [label=<training-serving <B>skew</B> → <B>feature store</B>> group="eixo"];
      n8_3_2_0_0 -> n8_3_2_1_0;
      n8_3_2_0_1 -> n8_3_2_1_0;
      n8_3_2_0_m -> n8_3_2_1_0 [style=invis];
    }
    subgraph cluster_8_3_3 {
      label=<<B>8.3.3</B>&#160;&#160;Infraestrutura, Containers e Orquestração>; labeljust="l"; style="filled"; fillcolor="#f2f2f2"; color="#d4d4d4"; margin=10;
      n8_3_3_0_0 [label=<manual → <B>IaC</B> (Terraform): recriar + registrar> group="eixo"];
      n8_3_3_1_0 [label=<container tem limite → <B>Kubernetes</B> orquestra> group="eixo"];
      n8_3_3_0_0 -> n8_3_3_1_0;
    }
    subgraph cluster_8_3_4 {
      label=<<B>8.3.4</B>&#160;&#160;Escalabilidade e Disponibilidade>; labeljust="l"; style="filled"; fillcolor="#f2f2f2"; color="#d4d4d4"; margin=10;
      n8_3_4_0_0 [label=<vertical ↔ <B>horizontal</B> + balanceador + autoscaling> group="eixo"];
      n8_3_4_1_0 [label=<escalável ≠ <B>disponível</B>: ponto único de falha> group="eixo"];
      n8_3_4_0_0 -> n8_3_4_1_0;
    }
  }
  subgraph cluster_8_4 {
    label=<<B>8.4</B>&#160;&#160;Limitações, Trade-offs e Desafios Atuais>; labeljust="l"; style="filled"; fillcolor="#f2f2f2"; color="#d4d4d4"; margin=10;
    n8_4_0_0 [label=<<B>under</B> ↔ <B>over</B>provisioning> group="eixo"];
    n8_4_1_0 [label=<sofisticado ≠ melhor (serviço interno)> group="eixo"];
    n8_4_0_0 -> n8_4_1_0;
    n8_4_2_0 [label=<resiliência + <B>degradação graciosa</B>> group="eixo"];
    n8_4_1_0 -> n8_4_2_0;
  }
  subgraph cluster_8_5 {
    label=<<B>8.5</B>&#160;&#160;Conclusão>; labeljust="l"; style="filled"; fillcolor="#f2f2f2"; color="#d4d4d4"; margin=10;
    n8_5_0_0 [label=<atender <B>requisitos</B> com controle, não complexidade> group="eixo"];
  }
  n8_1_2_0 -> n8_2_0_0 [style=invis];
  n8_2_2_0 -> n8_3_1_0_0 [style=invis];
  n8_3_1_2_0 -> n8_3_2_0_m [style=invis];
  n8_3_2_1_0 -> n8_3_3_0_0 [style=invis];
  n8_3_3_1_0 -> n8_3_4_0_0 [style=invis];
  n8_3_4_1_0 -> n8_4_0_0 [style=invis];
  n8_4_2_0 -> n8_5_0_0 [style=invis];
}
